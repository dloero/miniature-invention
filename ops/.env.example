# Ringbridge — environment template
# ---------------------------------------------------------------
# Copy this file to ops/.env and fill values as you work through
# ops/CHECKLIST.md. `ops/.env` is gitignored and will not be pushed.
# ---------------------------------------------------------------

# ---- Phase 1: Identity & legal ----
OPERATOR_EMAIL=
RINGBRIDGE_DOMAIN=
LLC_NAME=
LLC_ID=
EIN=

# ---- Phase 2: API & infra ----
ANTHROPIC_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

DEEPGRAM_API_KEY=
CARTESIA_API_KEY=

CAL_COM_API_KEY=

DATABASE_URL=

FLY_API_TOKEN=
VERCEL_TOKEN=

RESEND_API_KEY=

# ---- Phase 3: Recommended ----
BUSINESS_EMAIL=
STRIPE_SECRET_KEY=

# ---- Runtime flags ----
NODE_ENV=development
PYTHON_ENV=development
